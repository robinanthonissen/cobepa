{% extends "base.twig" %}

{% block content %}
	<div class="content-wrapper">
		<article class="post-type-{{post.post_type}}" id="post-{{post.ID}}">
			<section class="page-content">
				<div class="bg-dark pt-120 pt-lg-200 pb-50 pb-lg-100">
					<div class="container">
						<h1 class="article-h1 text-center text-white">{{post.title}}</h1>
					</div>
				</div>
				<div class="page-body">
					{{post.content}}
				</div>
			</section>
		</article>
	</div><!-- /content-wrapper -->
{% endblock %}
