{% extends "base.twig" %}

{% block content %}
	{% include 'partial/page-header.twig' with {
		title: header.title,
		intro: header.intro,
		image: header.image,
		breadcrumbs: header.breadcrumbs,
		class: header_overlap ? 'c-page-header--overlap' : ''
	} %}

	<article class="page-blocks post-type-{{ post.post_type }}" id="post-{{ post.ID }}">
		{{ post.content }}
	</article>
{% endblock %}
