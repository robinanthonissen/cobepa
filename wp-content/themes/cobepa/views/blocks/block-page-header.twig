{#
/**
 * Block Name: Page Header Block
 * Velden: title (leeg = paginatitel), intro, image, breadcrumbs
 */
#}
<div id="{{ block.anchor ? block.anchor : 'block-page-header-' ~ block.id }}" class="b-page-header">
	{% include 'partial/page-header.twig' with {
		title: fields.title ?: post.title,
		intro: fields.intro,
		image: fields.image ? Image(fields.image) : null,
		breadcrumbs: (fields.breadcrumbs is not null and not fields.breadcrumbs) ? [] : function('cobepa_breadcrumbs', post.ID)
	} %}
</div>
