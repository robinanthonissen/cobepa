{#
/**
 * Block Name: Image Text Block
 * Velden: image, overline, title, text, button, reverse, full_width, background_color
 */
#}
{% set image = fields.image ? Image(fields.image) : null %}
{% set bg = fields.background_color ?: 'bg-white' %}

<section id="{{ block.anchor ? block.anchor : 'block-image-text-' ~ block.id }}" class="b-image-text {{ bg }}{% if fields.reverse %} b-image-text--reverse{% endif %}{% if fields.full_width %} b-image-text--full{% endif %}">
	<div class="{% if not fields.full_width %}container {% endif %}b-image-text__inner">
		<div class="b-image-text__media">
			{% if image %}
				<img class="b-image-text__image lazy"
					{% if not is_preview %}src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-{% endif %}src="{{ image.src('img-large') }}"
					alt="{{ image.alt }}"
					width="{{ image.width }}" height="{{ image.height }}">
			{% endif %}
		</div>
		<div class="b-image-text__content">
			{% if fields.overline %}
				<p class="overline">{{ fields.overline }}</p>
			{% endif %}
			{% if fields.title %}
				<h2 class="b-image-text__title">{{ fields.title }}</h2>
			{% endif %}
			{% if fields.text %}
				<div class="content-wrapper b-image-text__text">{{ fields.text }}</div>
			{% endif %}
			{% if fields.button and fields.button.url %}
				<div class="c-buttons">
					<a class="btn {{ bg == 'bg-primary' ? 'btn-white' : 'btn-primary' }}" href="{{ fields.button.url }}" {% if fields.button.target %}target="{{ fields.button.target }}"{% endif %}>{{ fields.button.title }}</a>
				</div>
			{% endif %}
		</div>
	</div>
</section>
