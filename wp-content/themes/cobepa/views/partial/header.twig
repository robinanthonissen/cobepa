<a class="skip-link" href="#app">{{ __('Naar de inhoud', 'cobepa') }}</a>

<header class="l-header js-l-header">
	<div class="container">
		<div class="l-header__inner">

			<a href="{{ site.link }}" class="l-header__brand" aria-label="{{ site.title }} – {{ __('home', 'cobepa') }}">
				<span class="l-header__brand-name">{{ options.brand_name ?: site.title }}</span>
				{% if site.description %}
					<span class="l-header__brand-tagline">{{ site.description }}</span>
				{% endif %}
			</a>

			{% if main.items %}
				<nav class="l-header__nav" aria-label="{{ __('Hoofdmenu', 'cobepa') }}">
					<ul class="l-header__nav-list">
						{% for item in main.items %}
							{% set is_active = item.current or item.current_item_parent or item.current_item_ancestor %}
							<li class="l-header__nav-item {{ item.classes|join(' ') }}{% if item.children %} has-children{% endif %}">
								<a href="{{ item.link }}"
									class="l-header__nav-link{% if is_active %} is-active{% endif %}"
									{% if item.current %}aria-current="page"{% endif %}
									{% if item.target %}target="{{ item.target }}"{% endif %}>
									{{ item.title }}
									{% if item.children %}
										<svg class="l-header__nav-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
									{% endif %}
								</a>
								{% if item.children %}
									<ul class="l-header__dropdown">
										{% for child in item.children %}
											<li>
												<a class="l-header__dropdown-link{% if child.current %} is-active{% endif %}" href="{{ child.link }}" {% if child.current %}aria-current="page"{% endif %}>{{ child.title }}</a>
											</li>
										{% endfor %}
									</ul>
								{% endif %}
							</li>
						{% endfor %}
					</ul>
				</nav>
			{% endif %}

			<div class="l-header__actions">
				{% if options.header_button and options.header_button.url %}
					<a class="btn btn-primary l-header__cta" href="{{ options.header_button.url }}" {% if options.header_button.target %}target="{{ options.header_button.target }}"{% endif %}>{{ options.header_button.title }}</a>
				{% endif %}

				<button class="l-header__toggle js-c-menu-button" type="button" aria-controls="c-menu" aria-expanded="false" aria-label="{{ __('Menu openen', 'cobepa') }}">
					<span class="l-header__toggle-bar"></span>
					<span class="l-header__toggle-bar"></span>
					<span class="l-header__toggle-bar"></span>
				</button>
			</div>

		</div>
	</div>
</header>
