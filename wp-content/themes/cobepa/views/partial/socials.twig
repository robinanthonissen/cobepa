{% set socials = [
	{ url: options.facebook, icon: 'fab fa-facebook-f', label: 'Facebook' },
	{ url: options.instagram, icon: 'fab fa-instagram', label: 'Instagram' },
	{ url: options.linkedin, icon: 'fab fa-linkedin-in', label: 'LinkedIn' },
	{ url: options.youtube, icon: 'fab fa-youtube', label: 'YouTube' },
	{ url: options.twitter, icon: 'fab fa-twitter', label: 'X (Twitter)' }
] %}
{% if options.facebook or options.instagram or options.linkedin or options.youtube or options.twitter %}
	<div class="c-socials">
		{% for social in socials %}
			{% if social.url %}
				<a class="btn" href="{{ social.url }}" target="_blank" rel="noopener" aria-label="{{ social.label }}">
					<i class="{{ social.icon }}" aria-hidden="true"></i>
				</a>
			{% endif %}
		{% endfor %}
	</div>
{% endif %}
