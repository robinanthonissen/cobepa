<div class="c-socials">
    {% if options.facebook %}
        <a class="btn" href="{{ options.facebook }}">
            <i class="fab fa-facebook"></i>
        </a>
    {% endif %}
    {% if options.instagram %}
        <a class="btn" href="{{ options.instagram }}">
            <i class="fab fa-instagram"></i>
        </a>
    {% endif %}
    {% if options.linkedin %}
        <a class="btn" href="{{ options.linkedin }}">
            <i class="fab fa-linkedin"></i>
        </a>
    {% endif %}
    {% if options.youtube %}
        <a class="btn" href="{{ options.youtube }}">
            <i class="fab fa-youtube"></i>
        </a>
    {% endif %}
    {% if options.twitter %}
        <a class="btn" href="{{ options.twitter }}">
            <i class="fab fa-twitter"></i>
        </a>
    {% endif %}
</div>