{#
	Paginering
	Vars: pagination (Timber pagination object, bv. posts.pagination)
#}
{% if pagination.pages|length > 1 %}
	<nav class="c-pagination" aria-label="{{ __('Paginering', 'cobepa') }}">
		{% if pagination.prev %}
			<a class="c-pagination__step" href="{{ pagination.prev.link }}" rel="prev">
				{% include 'partial/icon.twig' with { name: 'arrow-left' } %}
				<span>{{ __('Vorige', 'cobepa') }}</span>
			</a>
		{% endif %}
		<ul class="c-pagination__pages">
			{% for page in pagination.pages %}
				<li>
					{% if page.link %}
						<a class="c-pagination__page" href="{{ page.link }}">{{ page.title }}</a>
					{% elseif page.current %}
						<span class="c-pagination__page is-current" aria-current="page">{{ page.title }}</span>
					{% else %}
						<span class="c-pagination__dots">{{ page.title }}</span>
					{% endif %}
				</li>
			{% endfor %}
		</ul>
		{% if pagination.next %}
			<a class="c-pagination__step" href="{{ pagination.next.link }}" rel="next">
				<span>{{ __('Volgende', 'cobepa') }}</span>
				{% include 'partial/icon.twig' with { name: 'arrow-right' } %}
			</a>
		{% endif %}
	</nav>
{% endif %}
