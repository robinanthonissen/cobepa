{% set footer_menus = [footer_col_1, footer_col_2, footer_col_3] %}
{% set has_address = options.address or options.zip_code or options.city %}
{% set maps_url = options.maps_url ?: 'https://www.google.com/maps/search/?api=1&query=' ~ ([options.address, options.zip_code, options.city]|join(' ')|url_encode) %}

<footer class="l-footer">
	<div class="u-pole" aria-hidden="true"></div>

	<div class="l-footer__main">
		<div class="container">
			<div class="l-footer__grid">

				<div class="l-footer__col l-footer__col--brand">
					<a href="{{ site.link }}" class="l-footer__brand" aria-label="{{ site.title }} – {{ __('home', 'cobepa') }}">
						{% include 'partial/logo.twig' with { class: 'l-footer__logo' } %}
					</a>
					{% if options.footer_text %}
						<p class="l-footer__text">{{ options.footer_text|nl2br }}</p>
					{% endif %}
					{% include 'partial/socials.twig' %}
				</div>

				{# Adres- en contactkolom altijd renderen zodat het raster zijn kolommen behoudt #}
				<div class="l-footer__col{% if not has_address %} is-empty{% endif %}">
					{% if has_address %}
						<h2 class="l-footer__title">{{ __('Adres', 'cobepa') }}</h2>
						<address class="l-footer__address">
							{% if options.address %}{{ options.address }}<br>{% endif %}
							{{ options.zip_code }} {{ options.city }}
						</address>
						<a class="c-link-arrow l-footer__route" href="{{ maps_url }}" target="_blank" rel="noopener">
							{{ __('Route plannen', 'cobepa') }}
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
						</a>
					{% endif %}
				</div>

				<div class="l-footer__col{% if not (options.phone or options.email) %} is-empty{% endif %}">
					{% if options.phone or options.email %}
						<h2 class="l-footer__title">{{ __('Contact', 'cobepa') }}</h2>
						<ul class="l-footer__list">
							{% if options.email %}
								<li><a href="mailto:{{ options.email }}">{{ options.email }}</a></li>
							{% endif %}
							{% if options.phone %}
								<li><a href="tel:{{ options.phone|replace({' ': '', '.': '', '/': ''}) }}">{{ options.phone }}</a></li>
							{% endif %}
						</ul>
					{% endif %}
				</div>

				{% for menu in footer_menus %}
					{% if menu.items %}
						<nav class="l-footer__col" aria-label="{{ menu.title }}">
							<h2 class="l-footer__title">{{ menu.title }}</h2>
							<ul class="l-footer__list">
								{% for item in menu.items %}
									<li class="{{ item.classes|join(' ') }}">
										<a href="{{ item.link }}" {% if item.current %}aria-current="page"{% endif %} {% if item.target %}target="{{ item.target }}"{% endif %}>{{ item.title }}</a>
									</li>
								{% endfor %}
							</ul>
						</nav>
					{% endif %}
				{% endfor %}

			</div>
		</div>
	</div>

	<div class="l-footer__bottom">
		<div class="container">
			<div class="l-footer__bottom-inner">
				<p class="l-footer__copyright">
					© {{ 'now'|date('Y') }} {{ options.company_name ?: site.title }}
					{% if options.vat %}<span class="l-footer__sep" aria-hidden="true">·</span> {{ __('Ondernemingsnr.', 'cobepa') }} {{ options.vat }}{% endif %}
				</p>

				{% if legal.items %}
					<nav class="l-footer__legal" aria-label="{{ __('Juridisch', 'cobepa') }}">
						{% for item in legal.items %}
							<a href="{{ item.link }}">{{ item.title }}</a>
						{% endfor %}
					</nav>
				{% endif %}

				<div class="l-footer__created">
					<span>site created by</span>
					<a href="https://rawd.be/" target="_blank" rel="noopener" aria-label="RAWD">
						<img class="l-footer__created-logo" src="{{ theme.link }}/src/img/rawd/logo-rawd-white.svg" alt="RAWD" width="32" height="16">
					</a>
				</div>
			</div>
		</div>
	</div>
</footer>
